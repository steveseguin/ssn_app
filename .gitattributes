# Auto detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicit text files
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.sh text eol=lf
PKGBUILD text eol=lf
.SRCINFO text eol=lf
*.desktop text eol=lf
*.npmrc text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary
*.exe binary
*.dll binary
*.node binary

# Private local data must also stay out of source archives.
**/.agents/** export-ignore
**/.codex/** export-ignore
**/.codex-tmp*/** export-ignore
**/.codex-tmp-*.diff export-ignore
**/.claude/** export-ignore
**/.playwright-mcp/** export-ignore
**/artifacts/** export-ignore
**/claude-artifacts/** export-ignore
**/webstore/** export-ignore
**/monetization-server/** export-ignore
**/[Mm]eta-[Aa]pp-[Rr]eview* export-ignore
**/[Mm]eta-[Aa]pp-[Rr]eview*/** export-ignore
**/[Mm]eta-[Rr]eview* export-ignore
**/[Mm]eta-[Rr]eview*/** export-ignore
**/[Ff]acebook-[Aa]pp-[Rr]eview* export-ignore
**/[Ff]acebook-[Aa]pp-[Rr]eview*/** export-ignore
**/prior-submission-* export-ignore
**/prior-submission-*/** export-ignore
**/.env export-ignore
**/.env.* export-ignore
**/.secret export-ignore
**/.secret.* export-ignore
**/.dev.vars export-ignore
**/.dev.vars.* export-ignore
**/.env.example -export-ignore
**/.dev.vars.example -export-ignore
