# Build Configuration
# Copy this file to build-config.env and fill in your values

# Windows Code Signing Certificate Password
# This is required for signing Windows builds
WIN_CSC_KEY_PASSWORD=your_certificate_password_here
# WIN_CSC_PFX_BASE64=base64_encoded_pfx_contents_here

# VirusTotal API key (optional)
# Used by the Windows release workflow for best-effort malware scanning submissions
# VT_API_KEY=your_virustotal_api_key_here

# macOS Code Signing (optional)
# CSC_LINK=path/to/certificate.p12
# CSC_KEY_PASSWORD=your_mac_certificate_password

# GitHub Token for releases (optional)
# GH_TOKEN=your_github_token
