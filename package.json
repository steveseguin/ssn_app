{
  "name": "SocialStream",
  "version": "0.3.124",
  "description": "Standalone version of Social Stream Ninja",
  "author": "Steve Seguin <steve@seguin.email>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start2": "electron . --running-from-source",
    "start3": "electron . --running-from-source --filesource C:/Users/steve/Code/social_stream/",
    "start4": "electron . --running-from-source --filesource /Users/steveseguin/Code/social_stream/",
    "start-linux": "electron . --running-from-source --filesource /home/ubuntu/code/ssn_app/resources/social_stream_fallback/main/",
    "update:fallback": "node scripts/updateSocialStreamFallback.js",
    "test:settings-loss": "node tests/electron/settings-loss-diagnostics.js",
    "test:settings-rootcause": "node tests/electron/settings-rootcause-diagnostics.js",
    "test:settings-transfer": "node tests/electron/settings-transfer-e2e.js",
    "test:stability-recovery": "node tests/electron/stability-recovery-diagnostics.js",
    "test:source-url-parsing": "node tests/electron/source-url-parsing-regression.js",
    "test:tiktok-auto-mode": "node tests/tiktok/auto-mode-regression.js",
    "test:tiktok-gift-regression": "node tests/tiktok/gift-count-regression.js",
    "test:tiktok-social-signals": "node tests/tiktok/social-signal-regression.js",
    "test:recent-changes": "node tests/electron/stability-recovery-diagnostics.js && node tests/electron/settings-transfer-e2e.js && node tests/tiktok/auto-mode-regression.js && node tests/tiktok/gift-count-regression.js && node tests/tiktok/social-signal-regression.js",
    "submit:virustotal": "node scripts/submit-virustotal.js --dir dist",
    "test": "electron .",
    "build": "run-os",
    "check:submodules": "node scripts/check-submodules.js",
    "prebuild": "npm run check:submodules && npm run update:fallback",
    "prebuild:win32": "npm run clean && npm run check:submodules && npm run update:fallback && node -e \"setTimeout(() => {}, 5000)\"",
    "build:win32": "electron-builder --win",
    "prebuild:darwin": "npm run clean && npm run check:submodules && npm run update:fallback",
    "build:darwin": "electron-builder --mac --x64 && electron-builder --mac --arm64",
    "prebuild:linux": "npm run clean && npm run check:submodules && npm run update:fallback",
    "build:linux": "electron-builder --linux",
    "build:rpi": "USE_SYSTEM_FPM=true electron-builder --armv7l --linux deb",
    "clean": "rimraf ./dist",
    "release": "electron-builder --publish always",
    "preinstall": "npx npm-force-resolutions",
    "postinstall": "node -e \"console.log('[custom-electron] Skipping legacy custom Electron install; using standard Electron package.')\" && node scripts/patch-deps.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/steveseguin/ssn_app.git"
  },
  "build": {
    "appId": "socialstream.electron",
    "productName": "socialstream",
    "npmRebuild": false,
    "files": [
      "package.json",
      "main.js",
      "renderer.js",
      "manifest.js",
      "state.js",
      "libs.js",
      "circular-buffer.js",
      "index.html",
      "prompt.html",
      "chathistory.html",
      "chathistory.js",
      "main.css",
      "thumbnail.js",
      "settings-backup.js",
      "worker-tts.js",
      "tts-worker.js",
      "transfer-backup.js",
      "transfer-backup-runner.js",
      "transfer-restore-runner.js",
      "websocket-monitor.js",
      "youtube.js",
      "tiktok-auth.js",
      "tiktok-badges.js",
      "error-reporter.js",
      "preload.js",
      "preload-mock.js",
      "preload-kasada.js",
      "assets/**",
      "resources/**",
      "tiktok/**",
      "tiktok-signing/electron-signer.js",
      "build/Release/**",
      "Kokoro-82M-ONNX/**/*",
      "node_modules/**/*",
      "!**/*.map",
      "!**/*.md",
      "!**/*.log",
      "!**/*.ts",
      "!**/*.ps1",
      "!**/*.sh",
      "!**/*.bat",
      "!**/*.cmd",
      "!**/*.pem",
      "!**/*.key",
      "!**/*.pfx",
      "!**/*.p12",
      "!**/*.crt",
      "!**/*.cer",
      "!certs/**",
      "!old-certs-backup/**",
      "!dist/**",
      "!sso-worker/**",
      "!aur/**",
      "!aur-repo/**",
      "!tests/**",
      "!scripts/**",
      "!build-config.env",
      "!build-config.env.example",
      "!electron-builder.env",
      "!*.env",
      "!*.env.*",
      "!code-signing-cert.pem",
      "!*.iml",
      "!npm-shrinkwrap.json",
      "!.claude/**",
      "!claude-artifacts/**"
    ],
    "asarUnpack": [
      "Kokoro-82M-ONNX/**/*",
      "resources/social_stream_fallback/**/*"
    ],
    "mac": {
      "category": "public.build.automation",
      "icon": "assets/icons/mac/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "./build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "This app requires camera access to record video.",
        "NSMicrophoneUsageDescription": "This app requires microphone access to record audio."
      },
      "artifactName": "socialstreamninja_mac_v${version}_${arch}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150
        },
        {
          "x": 440,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "socialstreamninja_mac_v${version}_${arch}.dmg",
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/win/icon.ico",
      "signtoolOptions": {
        "certificateFile": "certs/socialstream.pfx",
        "publisherName": "Steve Seguin",
        "timeStampServer": "http://timestamp.digicert.com",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "sign": "./customSign.js"
      }
    },
    "linux": {
      "category": "public.build.automation",
      "icon": "assets/icons/png/256x256.png",
      "artifactName": "socialstreamninja_linux_v${version}_${arch}.${ext}",
      "target": "AppImage",
      "executableName": "socialstreamninja"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "Social Stream Ninja",
      "include": "installer.nsh",
      "artifactName": "socialstreamninja-setup-${version}.${ext}",
      "installerIcon": "assets/icons/win/icon.ico",
      "uninstallerIcon": "assets/icons/win/icon.ico",
      "differentialPackage": false,
      "warningsAsErrors": false
    },
    "portable": {
      "artifactName": "socialstreamninja-portable.exe",
      "requestExecutionLevel": "user"
    },
    "appx": {
      "applicationId": "socialstream",
      "backgroundColor": "#464646",
      "identityName": "socialstream",
      "publisherDisplayName": "Steve Seguin",
      "artifactName": "socialstreamninja-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "afterSign": "./afterSign.js",
    "afterAllArtifactBuild": "./afterPack.js"
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.5.0",
    "electron-notarize": "git+https://github.com/electron/notarize.git",
    "fs-extra": "^11.3.4",
    "jsonfile": "^6.1.0",
    "npm-force-resolutions": "^0.0.10",
    "rimraf": "^6.0.1",
    "run-script-os-fix": "^1.0.4",
    "tsx": "^4.20.5"
  },
  "dependencies": {
    "@eulerstream/euler-websocket-sdk": "^0.0.6",
    "@huggingface/transformers": "git+https://github.com/steveseguin/transformers.js",
    "app-builder-lib": "^26.0.12",
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "bufferutil": "^4.0.9",
    "color": "^5.0.0",
    "color-convert": "^3.0.1",
    "color-name": "^2.0.0",
    "electron-context-menu": "^3.6.1",
    "electron-fetch": "^1.9.1",
    "electron-is-dev": "^3.0.1",
    "electron-prompt": "^1.7.0",
    "electron-store": "^8.2.0",
    "es5-ext": "git+https://github.com/steveseguin/es5-ext.git#main",
    "idb": "^8.0.2",
    "kokoro-js": "^1.2.0",
    "minimalist": "^1.0.0",
    "minimist": "git+https://github.com/fortiZde/minimist.git",
    "phonemizer": "^1.2.1",
    "sharp": "^0.34.5",
    "tiktok-live-connector": "^2.1.0",
    "undici": "^7.5.0",
    "unzipper": "^0.12.3",
    "utf-8-validate": "^6.0.5",
    "ws": "^8.18.1",
    "yargs": "^17.7.2"
  },
  "overrides": {
    "tiktok-live-connector": {
      "protobufjs": "7.6.1"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
