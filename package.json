{
  "name": "SocialStream",
	"version": "0.4.20",
  "description": "Standalone version of Social Stream Ninja",
  "author": "Steve Seguin <steve@seguin.email>",
  "desktopName": "socialstreamninja.desktop",
  "main": "bootstrap.js",
  "scripts": {
    "start": "electron .",
    "start2": "electron . --running-from-source",
    "start3": "electron . --running-from-source --filesource C:/Users/steve/Code/social_stream/",
    "start4": "electron . --running-from-source --filesource /Users/steveseguin/Code/social_stream/",
    "start-linux": "electron . --running-from-source --filesource /home/ubuntu/code/ssn_app/resources/social_stream_fallback/main/",
    "update:fallback": "node scripts/updateSocialStreamFallback.js",
    "test:settings-loss": "node tests/electron/settings-loss-diagnostics.js",
    "test:settings-rootcause": "node tests/electron/settings-rootcause-diagnostics.js",
    "test:settings-transfer": "node tests/electron/settings-transfer-e2e.js",
    "test:session-isolation": "node tests/electron/session-isolation-e2e.js",
    "start:headless": "bash scripts/start-headless.sh",
    "test:headless-launcher": "bash tests/electron/headless-launcher-regression.sh",
    "test:hidden-capture": "node tests/electron/hidden-capture-diagnostics.js",
    "test:reflection-filter": "node tests/electron/reflection-filter-e2e.js",
    "test:hidden-capture:soak": "node tests/electron/hidden-capture-soak.js",
    "test:twitch-bot-account:e2e": "node tests/electron/twitch-bot-account-e2e.js",
    "test:twitch-signin-compat": "node tests/electron/twitch-signin-compat-e2e.js",
    "test:rumble-chrome-signin": "node tests/electron/rumble-chrome-signin-regression.js",
    "test:rumble-chrome-signin:browser": "node tests/electron/rumble-chrome-signin-regression.js --live-browser",
    "test:rumble-chrome-signin:e2e": "node tests/electron/rumble-chrome-signin-ui-e2e.js",
    "test:translation-layout:e2e": "node tests/electron/translation-layout-e2e.js",
    "test:rumble-chrome-signin:persistence": "node tests/electron/rumble-chrome-session-persistence-e2e.js",
    "test:twitch-websocket:soak": "node tests/electron/twitch-websocket-soak.js",
    "test:source-navigation-safety": "node tests/electron/source-navigation-safety-e2e.js",
    "test:kick-adaptive-preload": "node tests/electron/kick-adaptive-preload-e2e.js",
    "test:portable-paths": "node tests/electron/portable-data-paths-regression.js",
    "test:portable-migration": "node tests/electron/portable-migration-runner-regression.js",
    "test:portable:e2e": "node tests/electron/portable-build-e2e.js",
    "test:stability-recovery": "node tests/electron/stability-recovery-diagnostics.js",
    "test:streamdeck-bridge": "node tests/electron/streamdeck-bridge-e2e.js",
    "test:streamdeck-plugin:e2e": "npm --prefix ../social_stream/ssn-streamdeck/plugin run build && node tests/electron/streamdeck-plugin-e2e.js",
    "test:tts": "node tests/electron/tts-diagnostics.js",
    "test:cohost-stt": "node tests/electron/cohost-stt-e2e.js",
    "test:cohost-stt:matrix": "node tests/electron/cohost-stt-audio-matrix.js",
    "test:local-media": "node tests/electron/local-media-library-regression.js",
    "test:local-websocket-config": "node tests/electron/local-websocket-config-regression.js",
    "test:local-websocket:e2e": "node tests/electron/local-websocket-port-e2e.js",
    "test:local-websocket:lan": "node tests/electron/local-websocket-port-e2e.js --lan",
    "test:local-websocket:packaged": "node tests/electron/local-websocket-port-e2e.js --packaged",
    "test:local-media:e2e": "node tests/electron/local-media-library-e2e.js",
    "test:eventflow-user-memory:e2e": "node tests/electron/eventflow-user-memory-e2e.js",
    "test:individual-likes:e2e": "node tests/electron/individual-like-routing-e2e.js",
    "test:popup-fallback-links:e2e": "node tests/electron/popup-fallback-links-e2e.js",
    "test:llm-diagnostics": "node tests/electron/llm-request-diagnostics-regression.js",
    "test:llm-diagnostics:e2e": "node tests/electron/llm-provider-diagnostics-e2e.js",
    "test:llm-control:e2e": "node tests/electron/llm-control-headless-e2e.js",
    "test:review-fixes": "node tests/electron/review-fixes-regression.js",
    "test:mcp-control:e2e": "node tests/electron/ssapp-mcp-e2e.js",
    "test:mcp-launch:e2e": "node tests/electron/ssapp-mcp-launch-e2e.js",
    "test:mcp-page-control:e2e": "node tests/electron/mcp-page-control-e2e.js",
    "test:mcp-app-window-dialog:e2e": "node tests/electron/mcp-app-window-dialog-e2e.js",
    "test:mcp-tiktok-soak": "node tests/electron/mcp-tiktok-live-soak.js",
    "test:mcp-setup": "node tests/electron/mcp-launch-config-regression.js",
    "mcp": "node resources/ssapp-mcp.js",
    "test:socialstream-path-security": "node tests/electron/socialstream-path-security-regression.js",
    "test:ipc-scaffold": "node tests/electron/ipc-scaffold-regression.js",
    "test:source-url-parsing": "node tests/electron/source-url-parsing-regression.js",
    "test:youtube-workflow": "node tests/electron/youtube-workflow-e2e.js",
    "test:discord-native": "node tests/discord/discord-bot-client-regression.js",
    "test:discord-native:e2e": "node tests/electron/discord-native-e2e.js",
    "test:live-chat": "node tests/electron/live-chat-capture-e2e.js",
    "test:youtube-owner-discovery": "node tests/electron/youtube-owner-discovery-regression.js",
    "test:youtube-oauth-loopback": "node tests/electron/youtube-oauth-loopback-e2e.js",
    "test:chathistory-export": "node tests/electron/chathistory-export-regression.js",
    "test:chathistory-origin:e2e": "node tests/electron/chathistory-origin-compat-e2e.js",
    "test:packaging-prune": "node tests/electron/prune-packaged-native-binaries-regression.js",
    "test:artifact-hook": "node tests/electron/artifact-hook-regression.js",
    "test:tiktok-auto-mode": "node tests/tiktok/auto-mode-regression.js",
    "test:tiktok-gift-regression": "node tests/tiktok/gift-count-regression.js",
    "test:tiktok-social-signals": "node tests/tiktok/social-signal-regression.js",
    "test:tiktok-dom-replay": "node tests/electron/tiktok-dom-replay-e2e.js",
    "test:tiktok-auth-ws": "node tests/tiktok/auth-ws-e2e.js",
    "test:tiktok-runner": "node tests/tiktok/runner-result-regression.js",
    "test:recent-changes": "node tests/electron/stability-recovery-diagnostics.js && node tests/electron/settings-transfer-e2e.js && node tests/tiktok/auto-mode-regression.js && node tests/tiktok/gift-count-regression.js && node tests/tiktok/social-signal-regression.js",
    "submit:virustotal": "node scripts/submit-virustotal.js --dir dist",
    "test": "electron .",
    "build": "run-os",
    "check:submodules": "node scripts/check-submodules.js",
    "prebuild": "npm run check:submodules && npm run update:fallback",
    "prebuild:win32": "npm run clean && npm run check:submodules && npm run update:fallback && node -e \"setTimeout(() => {}, 5000)\"",
    "build:win32": "electron-builder --win",
    "prebuild:darwin": "npm run clean && npm run check:submodules && npm run update:fallback",
    "build:darwin": "electron-builder --mac --x64 && electron-builder --mac --arm64",
    "prebuild:linux": "npm run clean && npm run check:submodules && npm run update:fallback",
    "build:linux": "electron-builder --linux",
    "build:rpi": "USE_SYSTEM_FPM=true electron-builder --armv7l --linux deb",
    "clean": "rimraf ./dist",
    "release": "electron-builder --publish always",
    "postinstall": "node scripts/patch-deps.js && node scripts/install-electron-binary.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/steveseguin/ssn_app.git"
  },
  "build": {
    "appId": "socialstream.electron",
    "productName": "socialstream",
    "npmRebuild": false,
    "files": [
      "package.json",
      "bootstrap.js",
      "main.js",
      "renderer.js",
      "manifest.js",
      "state.js",
      "libs.js",
      "circular-buffer.js",
      "hidden-window-keepalive.js",
      "index.html",
      "prompt.html",
      "chathistory.html",
      "chathistory.js",
      "main.css",
      "thumbnail.js",
      "settings-backup.js",
      "worker-tts.js",
      "tts-worker.js",
      "stt-worker.js",
      "transfer-backup.js",
      "transfer-backup-runner.js",
      "transfer-restore-runner.js",
      "websocket-monitor.js",
      "youtube.js",
      "discord.js",
      "tiktok-auth.js",
      "tiktok-badges.js",
      "error-reporter.js",
      "preload.js",
      "preload-mock.js",
      "preload-kasada.js",
      "preload-kick.js",
      "assets/**",
      "resources/**",
      "tiktok/**",
      "tiktok-signing/electron-signer.js",
      "build/Release/**",
      "Kokoro-82M-ONNX/**/*",
      "node_modules/**/*",
      "!**/*.map",
      "!**/*.md",
      "!**/*.log",
      "!**/*.ts",
      "!**/*.ps1",
      "!**/*.sh",
      "!**/*.bat",
      "!**/*.cmd",
      "!**/*.pem",
      "!**/*.key",
      "!**/*.pfx",
      "!**/*.p12",
      "!**/*.crt",
      "!**/*.cer",
      "!certs/**",
      "!old-certs-backup/**",
      "!dist/**",
      "!cloudflare/**",
      "!sso-worker/**",
      "!aur/**",
      "!aur-repo/**",
      "!tests/**",
      "!scripts/**",
      "!build-config.env",
      "!build-config.env.example",
      "!electron-builder.env",
      "!*.env",
      "!*.env.*",
      "!code-signing-cert.pem",
      "!*.iml",
      "!npm-shrinkwrap.json",
      "!.claude/**",
      "!claude-artifacts/**"
    ],
    "asarUnpack": [
      "Kokoro-82M-ONNX/**/*",
      "resources/social_stream_fallback/**/*"
    ],
    "mac": {
      "category": "public.build.automation",
      "icon": "assets/icons/mac/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "./build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "This app requires camera access to record video.",
        "NSMicrophoneUsageDescription": "This app requires microphone access to record audio."
      },
      "artifactName": "socialstreamninja_mac_v${version}_${arch}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150
        },
        {
          "x": 440,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "artifactName": "socialstreamninja_mac_v${version}_${arch}.dmg",
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/win/icon.ico",
      "signtoolOptions": {
        "certificateFile": "certs/socialstream.pfx",
        "publisherName": "Steve Seguin",
        "timeStampServer": "http://timestamp.digicert.com",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "sign": "./customSign.js"
      }
    },
    "linux": {
      "category": "Network;Chat",
      "icon": "assets/icons/png/256x256.png",
      "artifactName": "socialstreamninja_linux_v${version}_${arch}.${ext}",
      "target": "AppImage",
      "executableName": "socialstreamninja",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Social Stream Ninja",
          "GenericName": "Live chat aggregator",
          "Keywords": "chat;stream;twitch;youtube;kick;obs"
        }
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "Social Stream Ninja",
      "include": "installer.nsh",
      "artifactName": "socialstreamninja-setup-${version}.${ext}",
      "installerIcon": "assets/icons/win/icon.ico",
      "uninstallerIcon": "assets/icons/win/icon.ico",
      "differentialPackage": false,
      "warningsAsErrors": false
    },
    "portable": {
      "artifactName": "socialstreamninja-portable.exe",
      "requestExecutionLevel": "user"
    },
    "appx": {
      "applicationId": "socialstream",
      "backgroundColor": "#464646",
      "identityName": "socialstream",
      "publisherDisplayName": "Steve Seguin",
      "artifactName": "socialstreamninja-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "afterPack": "./scripts/prunePackagedNativeBinaries.js",
    "afterSign": "./afterSign.js",
    "afterAllArtifactBuild": "./afterPack.js"
  },
  "devDependencies": {
    "app-builder-lib": "^26.15.7",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "electron-notarize": "git+https://github.com/electron/notarize.git",
    "fs-extra": "^11.3.4",
    "jsonfile": "^6.1.0",
    "playwright-core": "^1.61.1",
    "rimraf": "^6.0.1",
    "run-script-os-fix": "^1.0.4",
    "tsx": "^4.23.1"
  },
  "dependencies": {
    "@eulerstream/euler-websocket-sdk": "^0.0.6",
    "@huggingface/transformers": "git+https://github.com/steveseguin/transformers.js",
    "archiver": "^8.0.0",
    "bufferutil": "^4.0.9",
    "color": "^5.0.0",
    "color-convert": "^3.0.1",
    "color-name": "^2.0.0",
    "electron-context-menu": "^3.6.1",
    "electron-fetch": "^1.9.1",
    "electron-is-dev": "^3.0.1",
    "electron-prompt": "^1.7.0",
    "electron-store": "^8.2.0",
    "es5-ext": "git+https://github.com/steveseguin/es5-ext.git#main",
    "idb": "^8.0.2",
    "kokoro-js": "^1.2.0",
    "minimalist": "^1.0.0",
    "minimist": "git+https://github.com/fortiZde/minimist.git",
    "phonemizer": "^1.2.1",
    "sharp": "^0.35.3",
    "tiktok-live-connector": "2.4.3",
    "undici": "^7.5.0",
    "unzipper": "^0.12.3",
    "utf-8-validate": "^6.0.5",
    "ws": "^8.18.1",
    "yargs": "^17.7.2"
  },
  "overrides": {
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
    "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
    "fast-uri": "3.1.4",
    "sharp": "$sharp",
    "tar": "7.5.22",
    "tiktok-live-connector": {
      "protobufjs": "7.6.1"
    }
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=8.0.0"
  }
}
